  waitingIcon: {
    fontSize: "35px",
    marginBottom: "10px",
  },

  bottomBar: {
    position: "fixed",
    left: 0,
    right: 0,
    bottom: 0,
    display: "flex",
    justifyContent: "center",
    alignItems: "center",
    gap: "20px",
    padding: "14px 20px",
    backgroundColor: "rgba(3,7,18,0.94)",
    borderTopWidth: "1px",
    borderTopStyle: "solid",
    borderTopColor: "#1f2937",
    backdropFilter: "blur(12px)",
  },

  controls: {
    display: "flex",
    gap: "9px",
  },

  controlButton: {
    minWidth: "105px",
    height: "42px",
    padding: "0 13px",
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    gap: "7px",
    color: "#ffffff",
    borderRadius: "9px",
    cursor: "pointer",
    fontSize: "12px",
    fontWeight: 600,
  },

  controlIcon: {
    fontSize: "15px",
  },

  connectionStatus: {
    display: "flex",
    alignItems: "center",
    gap: "7px",
    color: "#9ca3af",
    fontSize: "11px",
  },

  connectedDot: {
    width: "7px",
    height: "7px",
    borderRadius: "50%",
    backgroundColor: "#22c55e",
    display: "inline-block",

  videoContainer: {
    position: "relative",
    width: "100%",
    height: "100%",
  },

  video: {
    width: "100%",
    height: "100%",
    objectFit: "cover",
    display: "block",
    backgroundColor: "#030712",
  },

  avatar: {
    position: "absolute",
    inset: 0,
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    background: "radial-gradient(circle, #1f2937, #030712)",
    color: "#d1d5db",
    fontSize: "26px",
    fontWeight: 700,
  },

  participantName: {
    position: "absolute",
    left: "10px",
    bottom: "10px",
    padding: "6px 9px",
    backgroundColor: "rgba(0,0,0,0.65)",
    borderRadius: "7px",
    fontSize: "11px",
    fontWeight: 600,
  },

  micIndicator: {
    position: "absolute",
    right: "10px",
    bottom: "10px",
    width: "28px",
    height: "28px",
    display: "flex",

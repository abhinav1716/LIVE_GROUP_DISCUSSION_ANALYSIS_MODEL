
"use client";

import { useEffect, useRef, useState } from "react";
import {
  LocalVideoTrack,
  RemoteParticipant,
  RemoteTrack,
  RemoteTrackPublication,
  Room,
  RoomEvent,
  Track,
} from "livekit-client";

const API_URL = "http://127.0.0.1:8000";
const SESSION_ID = 2;

type Session = {
  id: number;
  topic: string;
  description: string | null;
  scheduled_at: string;
  duration_minutes: number;
  max_participants: number;
  registration_deadline: string;
  status: string;
  registered_count: number;
};

type Participant = {
  id: number;
  session_id: number;
  user_id: string | null;
  participant_type: string;
  speaker_id: string;
  joined_at: string;
  left_at: string | null;
};

type ParticipantTileProps = {
  participant: RemoteParticipant;
};

function ParticipantTile({ participant }: ParticipantTileProps) {
  const videoRef = useRef<HTMLVideoElement | null>(null);
  const audioRef = useRef<HTMLAudioElement | null>(null);

  const [videoTrack, setVideoTrack] = useState<RemoteTrack | null>(null);
  const [audioTrack, setAudioTrack] = useState<RemoteTrack | null>(null);

  useEffect(() => {
    const handleTrackSubscribed = (
      track: RemoteTrack,
      publication: RemoteTrackPublication
    ) => {
      if (publication.kind === Track.Kind.Video) {
        setVideoTrack(track);
      }

      if (publication.kind === Track.Kind.Audio) {
        setAudioTrack(track);
      }
    };

    const handleTrackUnsubscribed = (
      track: RemoteTrack,
      publication: RemoteTrackPublication
    ) => {
      if (publication.kind === Track.Kind.Video) {
        setVideoTrack(null);
      }

      if (publication.kind === Track.Kind.Audio) {
        setAudioTrack(null);
      }
    };

    participant.on(RoomEvent.TrackSubscribed, handleTrackSubscribed);
    participant.on(RoomEvent.TrackUnsubscribed, handleTrackUnsubscribed);

    participant.trackPublications.forEach((publication) => {
      if (publication.isSubscribed && publication.track) {
        if (publication.kind === Track.Kind.Video) {
          setVideoTrack(publication.track as RemoteTrack);
        }

        if (publication.kind === Track.Kind.Audio) {
          setAudioTrack(publication.track as RemoteTrack);
        }
      }
    });

    return () => {
      participant.off(RoomEvent.TrackSubscribed, handleTrackSubscribed);
      participant.off(RoomEvent.TrackUnsubscribed, handleTrackUnsubscribed);
    };
  }, [participant]);

  useEffect(() => {
    if (!videoTrack || !videoRef.current) {
      return;
    }

    videoTrack.attach(videoRef.current);

    return () => {
      if (videoRef.current) {
        videoTrack.detach(videoRef.current);
      }
    };
  }, [videoTrack]);

  useEffect(() => {
    if (!audioTrack || !audioRef.current) {
      return;
    }

    audioTrack.attach(audioRef.current);

    return () => {
      if (audioRef.current) {
        audioTrack.detach(audioRef.current);
      }
    };
  }, [audioTrack]);

  return (
    <div style={styles.participantTile}>
      <div style={styles.videoContainer}>
        {videoTrack ? (
          <video
            ref={videoRef}
            autoPlay
            playsInline
            style={styles.video}
          />
        ) : (
          <div style={styles.avatar}>
            {participant.name?.charAt(0).toUpperCase() || "P"}
          </div>
        )}

        <div style={styles.participantName}>
          {participant.name || participant.identity}
        </div>

        <div style={styles.micIndicator}>🎙️</div>
      </div>

      <audio ref={audioRef} autoPlay />
    </div>
  );
}

export default function Home() {
  const [session, setSession] = useState<Session | null>(null);
  const [participants, setParticipants] = useState<Participant[]>([]);
  const [participantId, setParticipantId] = useState("1");
  const [room, setRoom] = useState<Room | null>(null);

  const [isInRoom, setIsInRoom] = useState(false);
  const [isJoining, setIsJoining] = useState(false);
  const [isLeaving, setIsLeaving] = useState(false);
  const [isRecording, setIsRecording] = useState(false);

  const [micEnabled, setMicEnabled] = useState(false);
  const [cameraEnabled, setCameraEnabled] = useState(false);

  const [error, setError] = useState("");
  const [statusMessage, setStatusMessage] = useState("");
  const [evaluationStatus, setEvaluationStatus] = useState("");
  const [isEvaluating, setIsEvaluating] = useState(false);
  const [feedback, setFeedback] = useState<any | null>(null);
  const [feedbackError, setFeedbackError] = useState("");

  const localVideoRef = useRef<HTMLVideoElement | null>(null);
  const localVideoTrackRef = useRef<LocalVideoTrack | null>(null);

  // Recording references. The pending blob is retained if an upload fails.
  const mediaRecorderRef = useRef<MediaRecorder | null>(null);
  const recordingChunksRef = useRef<Blob[]>([]);
  const pendingRecordingRef = useRef<Blob | null>(null);
  const audioContextRef = useRef<AudioContext | null>(null);
  const audioDestinationRef =
    useRef<MediaStreamAudioDestinationNode | null>(null);
  const audioSourcesRef =
    useRef<Map<string, MediaStreamAudioSourceNode>>(new Map());

  const loadSession = async () => {
    try {
      const response = await fetch(
        `${API_URL}/gd/sessions/${SESSION_ID}`
      );

      if (!response.ok) {
        throw new Error("Unable to load GD session.");
      }

      const data: Session = await response.json();
      setSession(data);
    } catch (err) {
      console.error(err);
      setError("Could not connect to the GD backend.");
    }
  };

  const loadParticipants = async () => {
    try {
      const response = await fetch(
        `${API_URL}/gd/sessions/${SESSION_ID}/participants`
      );

      if (!response.ok) {
        throw new Error("Unable to load participants.");
      }

      const data: Participant[] = await response.json();
      setParticipants(data);
    } catch (err) {
      console.error(err);
    }
  };

  useEffect(() => {
    void loadSession();
    void loadParticipants();

    const interval = setInterval(() => {
      void loadSession();
      void loadParticipants();
    }, 5000);

    return () => {
      clearInterval(interval);
    };
  }, []);

  const attachLocalVideo = (track: LocalVideoTrack) => {
    if (!localVideoRef.current) {
      return;
    }

    track.attach(localVideoRef.current);
  };

  // Add a local or remote audio track to the recording mix.
  const addTrackToRecording = (track: RemoteTrack) => {
    const context = audioContextRef.current;
    const destination = audioDestinationRef.current;

    if (!context || !destination || track.kind !== Track.Kind.Audio) {
      return;
    }

    const mediaTrack = track.mediaStreamTrack;
    const trackKey = mediaTrack.id;

    if (audioSourcesRef.current.has(trackKey)) {
      return;
    }

    const stream = new MediaStream([mediaTrack]);
    const source = context.createMediaStreamSource(stream);

    source.connect(destination);
    audioSourcesRef.current.set(trackKey, source);
  };

  // Start recording once LiveKit and the microphone are connected.
  const startRoomRecording = async (activeRoom: Room) => {
    if (!navigator.mediaDevices || !window.MediaRecorder) {
      throw new Error("This browser does not support audio recording.");
    }

    const context = new AudioContext();
    audioContextRef.current = context;

    try {
      await context.resume();

      const destination = context.createMediaStreamDestination();
      audioDestinationRef.current = destination;
      audioSourcesRef.current.clear();

      // Capture the participant's microphone.
      const microphonePublication =
        activeRoom.localParticipant.getTrackPublication(
          Track.Source.Microphone
        );

      const microphoneTrack = microphonePublication?.track;

      if (microphoneTrack?.mediaStreamTrack) {
        const localStream = new MediaStream([
          microphoneTrack.mediaStreamTrack,
        ]);

        const localSource = context.createMediaStreamSource(localStream);
        localSource.connect(destination);

        audioSourcesRef.current.set(
          `local-${microphoneTrack.mediaStreamTrack.id}`,
          localSource
        );
      }

      // Capture remote participants and AI audio already subscribed.
      activeRoom.remoteParticipants.forEach((participant) => {
        participant.trackPublications.forEach((publication) => {
          if (
            publication.isSubscribed &&
            publication.track &&
            publication.kind === Track.Kind.Audio
          ) {
            addTrackToRecording(publication.track as RemoteTrack);
          }
        });
      });

      recordingChunksRef.current = [];
      pendingRecordingRef.current = null;

      const preferredMimeType = "audio/webm;codecs=opus";
      const mimeType = MediaRecorder.isTypeSupported(preferredMimeType)
        ? preferredMimeType
        : MediaRecorder.isTypeSupported("audio/webm")
          ? "audio/webm"
          : "";

      const recorder = mimeType
        ? new MediaRecorder(destination.stream, { mimeType })
        : new MediaRecorder(destination.stream);

      recorder.ondataavailable = (event: BlobEvent) => {
        if (event.data.size > 0) {
          recordingChunksRef.current.push(event.data);
        }
      };

      recorder.onstop = () => {
        pendingRecordingRef.current = new Blob(
          recordingChunksRef.current,
          { type: recorder.mimeType || "audio/webm" }
        );
      };

      mediaRecorderRef.current = recorder;
      recorder.start(1000);
      setIsRecording(true);
    } catch (err) {
      await context.close().catch(() => {});
      audioContextRef.current = null;
      audioDestinationRef.current = null;
      throw err;
    }
  };

  const cleanupRecordingResources = async () => {
    audioSourcesRef.current.forEach((source) => {
      try {
        source.disconnect();
      } catch {
        // The source may already be disconnected.
      }
    });

    audioSourcesRef.current.clear();

    if (audioContextRef.current) {
      try {
        await audioContextRef.current.close();
      } catch {
        // The audio context may already be closed.
      }
    }

    audioContextRef.current = null;
    audioDestinationRef.current = null;
    mediaRecorderRef.current = null;
    recordingChunksRef.current = [];
    pendingRecordingRef.current = null;

    setIsRecording(false);
  };

  // Stop the recorder and upload the resulting audio.
  // If upload fails, keep the blob so the user can retry.
  const stopAndUploadRoomRecording = async (
    activeParticipantId: number
  ) => {
    const recorder = mediaRecorderRef.current;

    if (recorder && recorder.state !== "inactive") {
      await new Promise<void>((resolve, reject) => {
        const handleStop = () => resolve();

        recorder.addEventListener("stop", handleStop, { once: true });

        try {
          recorder.stop();
        } catch (err) {
          recorder.removeEventListener("stop", handleStop);
          reject(err);
        }
      });
    }

    setIsRecording(false);

    const blob = pendingRecordingRef.current;

    if (!blob || blob.size === 0) {
      throw new Error(
        "No audio recording was captured. Check microphone permissions and try again."
      );
    }

    const formData = new FormData();

    formData.append(
      "file",
      blob,
      `gd-session-${SESSION_ID}-participant-${activeParticipantId}.webm`
    );

    const response = await fetch(
      `${API_URL}/gd/sessions/${SESSION_ID}/recording?participant_id=${activeParticipantId}`,
      {
        method: "POST",
        body: formData,
      }
    );

    const result = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(result.detail || "The recording upload failed.");
    }

    // Only clear the recording after the server confirms the upload.
    await cleanupRecordingResources();

    return result;
  };

  const loadFeedback = async () => {
    setFeedbackError("");
    const parsedParticipantId = Number(participantId);
    if (!Number.isInteger(parsedParticipantId) || parsedParticipantId <= 0) {
      setFeedbackError("Enter a valid participant ID to load feedback.");
      return;
    }
    try {
      const response = await fetch(
        `${API_URL}/gd/sessions/${SESSION_ID}/report?participant_id=${parsedParticipantId}`,
        { cache: "no-store" }
      );
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.detail || "Feedback is not available yet.");
      }
      setFeedback(data);
      setFeedbackError("");
    } catch (err) {
      setFeedbackError(err instanceof Error ? err.message : "Unable to load feedback.");
    }
  };

  const startEvaluation = async () => {
    const parsedParticipantId = Number(participantId);
    setIsEvaluating(true);
    setEvaluationStatus("Recording uploaded. Starting evaluation…");
    setFeedbackError("");
    try {
      const response = await fetch(
        `${API_URL}/gd/sessions/${SESSION_ID}/evaluate-latest?participant_id=${parsedParticipantId}`,
        { method: "POST" }
      );
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.detail || "Could not start evaluation.");
      }
      setEvaluationStatus("Evaluating your discussion. Feedback will appear here automatically…");

      // Poll evaluation status until the backend reports completion or failure.
      for (let attempt = 0; attempt < 180; attempt += 1) {
        await new Promise((resolve) => setTimeout(resolve, 3000));
        const statusResponse = await fetch(
          `${API_URL}/gd/sessions/${SESSION_ID}/evaluation-status?participant_id=${parsedParticipantId}`,
          { cache: "no-store" }
        );
        const statusData = await statusResponse.json().catch(() => ({}));
        if (!statusResponse.ok) {
          throw new Error(statusData.detail || "Unable to check evaluation status.");
        }
        if (statusData.status === "completed") {
          setEvaluationStatus(`Evaluation completed: ${statusData.evaluation_id || "report ready"}.`);
          await loadFeedback();
          return;
        }
        if (statusData.status === "failed") {
          throw new Error(statusData.error || "Evaluation failed.");
        }
      }
      throw new Error("Evaluation is taking longer than expected. Use Refresh Feedback to check again.");
    } catch (err) {
      setEvaluationStatus("");
      setFeedbackError(err instanceof Error ? err.message : "Evaluation could not be completed.");
    } finally {
      setIsEvaluating(false);
    }
  };

  const joinGD = async () => {
    setError("");
    setStatusMessage("");

    const parsedParticipantId = Number(participantId);

    if (!Number.isInteger(parsedParticipantId) || parsedParticipantId <= 0) {
      setError("Please enter a valid participant ID.");
      return;
    }

    if (!session) {
      setError("GD session information is not available.");
      return;
    }

    if (session.status !== "LIVE") {
      setError(
        `This GD session is currently ${session.status}. It must be LIVE to join.`
      );
      return;
    }

    try {
      setIsJoining(true);

      const response = await fetch(
        `${API_URL}/gd/sessions/${SESSION_ID}/livekit-token?participant_id=${parsedParticipantId}`,
        { method: "POST" }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.detail || "Unable to create LiveKit access token."
        );
      }

      const newRoom = new Room({
        adaptiveStream: true,
        dynacast: true,
      });

      // Capture audio tracks that are subscribed after recording starts.
      newRoom.on(
        RoomEvent.TrackSubscribed,
        (track: RemoteTrack, publication: RemoteTrackPublication) => {
          if (publication.kind === Track.Kind.Audio) {
            addTrackToRecording(track);
          }
        }
      );

      newRoom.on(
        RoomEvent.ParticipantConnected,
        (participant: RemoteParticipant) => {
          console.log("Participant connected:", participant.identity);
          void loadParticipants();
        }
      );

      newRoom.on(
        RoomEvent.ParticipantDisconnected,
        (participant: RemoteParticipant) => {
          console.log("Participant disconnected:", participant.identity);
          void loadParticipants();
        }
      );

      newRoom.on(RoomEvent.Disconnected, () => {
        console.log("Disconnected from LiveKit room.");
      });

      await newRoom.connect(data.livekit_url, data.token);
      await newRoom.localParticipant.setMicrophoneEnabled(true);
      setMicEnabled(true);

      try {
        await startRoomRecording(newRoom);
      } catch (recordingError) {
        console.error("Unable to start recording:", recordingError);

        await newRoom.localParticipant
          .setMicrophoneEnabled(false)
          .catch(() => {});

        newRoom.disconnect();

        throw new Error(
          recordingError instanceof Error
            ? `Could not start GD recording: ${recordingError.message}`
            : "Could not start GD recording."
        );
      }

      try {
        await newRoom.localParticipant.setCameraEnabled(true);
        setCameraEnabled(true);

        const publication =
          newRoom.localParticipant.getTrackPublication(
            Track.Source.Camera
          );

        if (
          publication &&
          publication.track instanceof LocalVideoTrack
        ) {
          localVideoTrackRef.current = publication.track;

          setTimeout(() => {
            if (publication.track instanceof LocalVideoTrack) {
              attachLocalVideo(publication.track);
            }
          }, 100);
        }
      } catch (cameraError) {
        console.warn("Camera could not be enabled:", cameraError);
        setCameraEnabled(false);
      }

      setRoom(newRoom);
      setIsInRoom(true);
      setStatusMessage(`Connected as ${data.speaker_id}`);

      await loadParticipants();
    } catch (err) {
      console.error(err);

      setError(
        err instanceof Error
          ? err.message
          : "Unable to join the GD session."
      );
    } finally {
      setIsJoining(false);
    }
  };

  const toggleMicrophone = async () => {
    if (!room) {
      return;
    }

    try {
      const newState = !micEnabled;

      await room.localParticipant.setMicrophoneEnabled(newState);
      setMicEnabled(newState);
    } catch (err) {
      console.error("Unable to toggle microphone:", err);
      setError("Could not change microphone state.");
    }
  };

  const toggleCamera = async () => {
    if (!room) {
      return;
    }

    try {
      const newState = !cameraEnabled;

      await room.localParticipant.setCameraEnabled(newState);
      setCameraEnabled(newState);

      if (newState) {
        const publication =
          room.localParticipant.getTrackPublication(Track.Source.Camera);

        if (
          publication &&
          publication.track instanceof LocalVideoTrack
        ) {
          localVideoTrackRef.current = publication.track;

          setTimeout(() => {
            if (publication.track instanceof LocalVideoTrack) {
              attachLocalVideo(publication.track);
            }
          }, 100);
        }
      }
    } catch (err) {
      console.error("Unable to toggle camera:", err);
      setError("Could not change camera state.");
    }
  };

  const leaveGD = async () => {
    if (isLeaving) {
      return;
    }

    setError("");
    setIsLeaving(true);

    try {
      if (room) {
        const parsedParticipantId = Number(participantId);

        if (
          !Number.isInteger(parsedParticipantId) ||
          parsedParticipantId <= 0
        ) {
          throw new Error("Please enter a valid participant ID.");
        }

        // Upload before disconnecting, while the participant is still active.
        await stopAndUploadRoomRecording(parsedParticipantId);

        await room.localParticipant.setCameraEnabled(false);
        await room.localParticipant.setMicrophoneEnabled(false);

        room.disconnect();

        setStatusMessage("Recording uploaded successfully.");
        void startEvaluation();
      }
    } catch (err) {
      console.error("Error while leaving GD:", err);

      setError(
        err instanceof Error
          ? `${err.message} Your connection is still open. Click Leave GD again to retry the upload.`
          : "The recording could not be uploaded. Your connection is still open; try again."
      );

      return;
    } finally {
      setIsLeaving(false);
    }

    if (localVideoTrackRef.current && localVideoRef.current) {
      localVideoTrackRef.current.detach(localVideoRef.current);
    }

    localVideoTrackRef.current = null;

    setRoom(null);
    setIsInRoom(false);
    setMicEnabled(false);
    setCameraEnabled(false);
  };

  const getStatusLabel = () => {
    if (!session) {
      return "Loading...";
    }

    if (session.status === "LIVE") {
      return "LIVE";
    }

    return session.status;
  };

  const formatDate = (dateString: string) => {
    try {
      return new Date(dateString).toLocaleString();
    } catch {
      return dateString;
    }
  };

  if (isInRoom && room) {
    const remoteParticipants = Array.from(room.remoteParticipants.values());

    return (
      <main style={styles.page}>
        <div style={styles.roomPage}>
          <header style={styles.roomHeader}>
            <div>
              <div style={styles.liveBadge}>
                <span style={styles.liveDot} />
                LIVE
              </div>

              <h1 style={styles.roomTitle}>
                {session?.topic || "Group Discussion"}
              </h1>

              <p style={styles.roomSubtitle}>
                Group Discussion • {session?.duration_minutes || 20} minutes
              </p>

              <p
                style={{
                  ...styles.roomSubtitle,
                  color: isRecording ? "#4ade80" : "#fbbf24",
                }}
              >
                {isRecording
                  ? "● Recording discussion audio"
                  : "Recording is not active"}
              </p>
            </div>

            <button
              onClick={leaveGD}
              disabled={isLeaving}
              style={{
                ...styles.leaveButton,
                opacity: isLeaving ? 0.65 : 1,
                cursor: isLeaving ? "wait" : "pointer",
              }}
            >
              {isLeaving ? "Uploading recording..." : "Leave GD"}
            </button>
          </header>

          {error && <div style={styles.errorBox}>{error}</div>}

          <section style={styles.roomContent}>
            <div style={styles.videoGrid}>
              <div style={styles.participantTile}>
                <div style={styles.videoContainer}>
                  <video
                    ref={localVideoRef}
                    autoPlay
                    muted
                    playsInline
                    style={styles.video}
                  />

                  {!cameraEnabled && (
                    <div style={styles.avatar}>You</div>
                  )}

                  <div style={styles.participantName}>You</div>

                  <div style={styles.micIndicator}>
                    {micEnabled ? "🎙️" : "🔇"}
                  </div>
                </div>
              </div>

              {remoteParticipants.map((participant) => (
                <ParticipantTile
                  key={participant.identity}
                  participant={participant}
                />
              ))}

              {remoteParticipants.length === 0 && (
                <div style={styles.waitingTile}>
                  <div style={styles.waitingIcon}>👥</div>
                  <h3>Waiting for other participants</h3>
                  <p>
                    Other GD participants will appear here when they join.
                  </p>
                </div>
              )}
            </div>
          </section>

          <div style={styles.bottomBar}>
            <div style={styles.controls}>
              <button
                onClick={toggleMicrophone}
                style={{
                  ...styles.controlButton,
                  backgroundColor: micEnabled ? "#1f2937" : "#7f1d1d",
                  borderWidth: "1px",
                  borderStyle: "solid",
                  borderColor: micEnabled ? "#374151" : "#991b1b",
                }}
              >
                <span style={styles.controlIcon}>
                  {micEnabled ? "🎙️" : "🔇"}
                </span>
                <span>{micEnabled ? "Mute" : "Unmute"}</span>
              </button>

              <button
                onClick={toggleCamera}
                style={{
                  ...styles.controlButton,
                  backgroundColor: cameraEnabled ? "#1f2937" : "#7f1d1d",
                  borderWidth: "1px",
                  borderStyle: "solid",
                  borderColor: cameraEnabled ? "#374151" : "#991b1b",
                }}
              >
                <span style={styles.controlIcon}>
                  {cameraEnabled ? "📹" : "🚫"}
                </span>
                <span>{cameraEnabled ? "Camera On" : "Camera Off"}</span>
              </button>

              <button
                onClick={leaveGD}
                disabled={isLeaving}
                style={{
                  ...styles.controlButton,
                  backgroundColor: "#991b1b",
                  borderWidth: "1px",
                  borderStyle: "solid",
                  borderColor: "#b91c1c",
                  opacity: isLeaving ? 0.65 : 1,
                  cursor: isLeaving ? "wait" : "pointer",
                }}
              >
                <span style={styles.controlIcon}>📞</span>
                <span>{isLeaving ? "Uploading..." : "Leave"}</span>
              </button>
            </div>

            <div style={styles.connectionStatus}>
              <span style={styles.connectedDot} />
              Connected
            </div>
          </div>
        </div>
      </main>
    );
  }

  return (
    <main style={styles.page}>
      <div style={styles.lobbyContainer}>
        <header style={styles.lobbyHeader}>
          <div>
            <div style={styles.brand}>COGNIVIEW</div>
            <div style={styles.brandSubtitle}>
              AI-Powered Interview Intelligence
            </div>
          </div>

          <div
            style={{
              display: "flex",
              alignItems: "center",
              justifyContent: "flex-end",
              gap: "10px",
              flexWrap: "wrap",
            }}
          >
            <a
              href="/interview"
              aria-label="Open AI Mock Interview"
              style={{
                display: "inline-flex",
                alignItems: "center",
                justifyContent: "center",
                gap: "8px",
                padding: "10px 15px",
                borderRadius: "12px",
                border: "1px solid rgba(96, 165, 250, 0.55)",
                background: "linear-gradient(135deg, #2563eb 0%, #6d28d9 100%)",
                color: "#ffffff",
                fontSize: "13px",
                fontWeight: 700,
                textDecoration: "none",
                whiteSpace: "nowrap",
                boxShadow: "0 8px 24px rgba(37, 99, 235, 0.18)",
              }}
            >
              <span aria-hidden="true">✦</span>
              AI Mock Interview
              <span aria-hidden="true">↗</span>
            </a>

            <div style={styles.statusPill}>
              <span style={styles.statusDot} />
              {getStatusLabel()}
            </div>
          </div>
        </header>

        {error && <div style={styles.errorBox}>{error}</div>}

        {statusMessage && (
          <div style={styles.successBox}>{statusMessage}</div>
        )}

        <section style={styles.heroCard}>
          <div style={styles.topicSection}>
            <div style={styles.topicLabel}>GROUP DISCUSSION</div>

            <h1 style={styles.topicTitle}>
              {session?.topic || "Loading GD Session..."}
            </h1>

            <p style={styles.topicDescription}>
              {session?.description ||
                "Join the live group discussion and interact with other participants."}
            </p>
          </div>

          <div style={styles.sessionInfoGrid}>
            <div style={styles.infoCard}>
              <div style={styles.infoIcon}>📅</div>
              <div>
                <div style={styles.infoLabel}>Scheduled</div>
                <div style={styles.infoValue}>
                  {session ? formatDate(session.scheduled_at) : "--"}
                </div>
              </div>
            </div>

            <div style={styles.infoCard}>
              <div style={styles.infoIcon}>⏱️</div>
              <div>
                <div style={styles.infoLabel}>Duration</div>
                <div style={styles.infoValue}>
                  {session ? `${session.duration_minutes} minutes` : "--"}
                </div>
              </div>
            </div>

            <div style={styles.infoCard}>
              <div style={styles.infoIcon}>👥</div>
              <div>
                <div style={styles.infoLabel}>Capacity</div>
                <div style={styles.infoValue}>
                  {session
                    ? `${session.registered_count} / ${session.max_participants}`
                    : "--"}
                </div>
              </div>
            </div>
          </div>
        </section>

        <section style={styles.joinCard}>
          <div style={styles.joinHeader}>
            <div>
              <h2 style={styles.joinTitle}>Join Group Discussion</h2>
              <p style={styles.joinDescription}>
                Enter your participant ID to enter the live discussion.
              </p>
            </div>

            <div style={styles.participantCount}>
              <strong>{participants.length}</strong>
              <span>participants</span>
            </div>
          </div>

          <div style={styles.formRow}>
            <div style={styles.inputGroup}>
              <label style={styles.inputLabel}>Participant ID</label>
              <input
                value={participantId}
                onChange={(event) => setParticipantId(event.target.value)}
                type="number"
                min="1"
                placeholder="Enter participant ID"
                style={styles.input}
              />
            </div>

            <button
              onClick={joinGD}
              disabled={
                isJoining || !session || session.status !== "LIVE"
              }
              style={{
                ...styles.joinButton,
                opacity:
                  isJoining || !session || session.status !== "LIVE"
                    ? 0.5
                    : 1,
                cursor:
                  isJoining || !session || session.status !== "LIVE"
                    ? "not-allowed"
                    : "pointer",
              }}
            >
              {isJoining ? "Connecting..." : "Join Discussion →"}
            </button>
          </div>

          {session && session.status !== "LIVE" && (
            <div style={styles.notLiveMessage}>
              This discussion is currently <strong>{session.status}</strong>.
              You can join once the session becomes LIVE.
            </div>
          )}
        </section>

        <section style={styles.joinCard}>
          <div style={styles.sectionHeader}>
            <div>
              <h2 style={styles.sectionTitle}>Your GD Feedback</h2>
              <p style={styles.sectionSubtitle}>
                Evaluation results appear here after you leave the discussion.
              </p>
            </div>
            <button
              onClick={loadFeedback}
              disabled={isEvaluating}
              style={styles.refreshButton}
            >
              ↻ Refresh Feedback
            </button>
          </div>

          {isEvaluating && (
            <div style={styles.successBox}>
              {evaluationStatus || "Evaluating your discussion…"}
            </div>
          )}
          {!isEvaluating && evaluationStatus && (
            <div style={styles.successBox}>{evaluationStatus}</div>
          )}
          {feedbackError && <div style={styles.errorBox}>{feedbackError}</div>}

          {feedback?.participant_report ? (
            <div>
              <div style={{ ...styles.infoCard, justifyContent: "space-between", marginBottom: "16px" }}>
                <div>
                  <div style={styles.infoLabel}>Participant · {feedback.participant_report.speaker}</div>
                  <div style={{ fontSize: "30px", fontWeight: 800, marginTop: "6px" }}>
                    {Number(feedback.participant_report.scores?.final_gd_score ?? 0).toFixed(2)}
                    <span style={{ fontSize: "14px", color: "#9ca3af" }}>/10</span>
                  </div>
                  <div style={{ color: "#9ca3af", fontSize: "12px", marginTop: "4px" }}>
                    {feedback.evaluation_id} · {feedback.participant_report.performance_band}
                  </div>
                </div>
                <div style={{ textAlign: "right" }}>
                  <div style={styles.infoLabel}>V3 model</div>
                  <strong>{Number(feedback.participant_report.scores?.v3_model_score ?? 0).toFixed(2)}/10</strong>
                  <div style={{ ...styles.infoLabel, marginTop: "12px" }}>Analytical</div>
                  <strong>{Number(feedback.participant_report.scores?.analytical_score ?? 0).toFixed(2)}/10</strong>
                </div>
              </div>

              <h3 style={{ margin: "18px 0 10px", fontSize: "17px" }}>Performance dimensions</h3>
              <div style={styles.sessionInfoGrid}>
                {Object.entries(feedback.participant_report.dimension_scores || {}).map(([key, value]) => (
                  <div key={key} style={styles.infoCard}>
                    <div style={{ flex: 1 }}>
                      <div style={styles.infoLabel}>{key.replaceAll("_", " ")}</div>
                      <strong>{Number(value).toFixed(2)}/10</strong>
                      <div style={{ height: "5px", background: "#263244", borderRadius: "8px", marginTop: "8px", overflow: "hidden" }}>
                        <div style={{ width: `${Math.max(0, Math.min(10, Number(value) || 0)) * 10}%`, height: "100%", background: "#818cf8" }} />
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              <div style={styles.sessionInfoGrid}>
                <div style={{ ...styles.infoCard, alignItems: "flex-start" }}>
                  <div>
                    <h3 style={{ margin: "0 0 10px", color: "#86efac" }}>Strengths</h3>
                    {(feedback.participant_report.strengths || []).map((item: string, index: number) => (
                      <p key={index} style={{ fontSize: "13px", lineHeight: 1.5, margin: "7px 0" }}>• {item}</p>
                    ))}
                  </div>
                </div>
                <div style={{ ...styles.infoCard, alignItems: "flex-start" }}>
                  <div>
                    <h3 style={{ margin: "0 0 10px", color: "#fca5a5" }}>Areas to improve</h3>
                    {(feedback.participant_report.weaknesses || []).map((item: string, index: number) => (
                      <p key={index} style={{ fontSize: "13px", lineHeight: 1.5, margin: "7px 0" }}>• {item}</p>
                    ))}
                  </div>
                </div>
              </div>

              <h3 style={{ margin: "18px 0 10px", fontSize: "17px" }}>Recommendations</h3>
              {(feedback.participant_report.recommendations || []).map((item: string, index: number) => (
                <p key={index} style={{ color: "#d1d5db", fontSize: "13px", lineHeight: 1.6, margin: "7px 0" }}>• {item}</p>
              ))}

              <h3 style={{ margin: "18px 0 10px", fontSize: "17px" }}>Participation metrics</h3>
              <div style={styles.sessionInfoGrid}>
                {Object.entries(feedback.participant_report.behavioral_metrics || {}).map(([key, value]) => (
                  <div key={key} style={styles.infoCard}>
                    <div>
                      <div style={styles.infoLabel}>{key.replaceAll("_", " ")}</div>
                      <strong>{typeof value === "number" ? (Number.isInteger(value) ? value : value.toFixed(2)) : String(value)}</strong>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            !isEvaluating && !feedbackError && (
              <p style={{ color: "#9ca3af", fontSize: "13px" }}>
                No feedback loaded yet. After a discussion, leave the GD and wait for evaluation, or select Refresh Feedback to load an existing report.
              </p>
            )
          )}
        </section>

        <section style={styles.participantsSection}>
          <div style={styles.sectionHeader}>
            <div>
              <h2 style={styles.sectionTitle}>Participants</h2>
              <p style={styles.sectionSubtitle}>
                People currently registered for this discussion
              </p>
            </div>

            <button
              onClick={loadParticipants}
              style={styles.refreshButton}
            >
              ↻ Refresh
            </button>
          </div>

          <div style={styles.participantsList}>
            {participants.length === 0 ? (
              <div style={styles.emptyState}>No participants found.</div>
            ) : (
              participants.map((participant) => (
                <div key={participant.id} style={styles.participantRow}>
                  <div style={styles.smallAvatar}>
                    {participant.participant_type === "AI"
                      ? "AI"
                      : participant.user_id?.charAt(0).toUpperCase() || "U"}
                  </div>

                  <div style={styles.participantDetails}>
                    <div style={styles.participantUser}>
                      {participant.user_id || participant.speaker_id}
                    </div>
                    <div style={styles.participantSpeaker}>
                      {participant.speaker_id}
                    </div>
                  </div>

                  <div
                    style={{
                      ...styles.typeBadge,
                      backgroundColor:
                        participant.participant_type === "AI"
                          ? "#312e81"
                          : "#064e3b",
                      borderWidth: "1px",
                      borderStyle: "solid",
                      borderColor:
                        participant.participant_type === "AI"
                          ? "#4338ca"
                          : "#047857",
                    }}
                  >
                    {participant.participant_type}
                  </div>
                </div>
              ))
            )}
          </div>
        </section>

        <footer style={styles.footer}>
          <span>Cogniview GD Intelligence System</span>
          <span>Live discussion powered by WebRTC</span>
        </footer>
      </div>
    </main>
  );
}

const styles: Record<string, React.CSSProperties> = {
  page: {
    minHeight: "100vh",

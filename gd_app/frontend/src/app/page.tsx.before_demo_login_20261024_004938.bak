    cursor: "pointer",
    fontWeight: 600,
  },

  roomContent: {
    minHeight: "calc(100vh - 240px)",
    display: "flex",
    alignItems: "center",
  },

  videoGrid: {
    width: "100%",
    display: "grid",
    gridTemplateColumns: "repeat(auto-fit, minmax(280px, 1fr))",
    gap: "14px",
